<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata minClientVersion="2.12">
    <id>MyOddWeb.DirectoryWatcher</id>
    <version>0.2.0</version>
    <title>MyOddWeb.DirectoryWatcher (x86/x64)</title>
    <authors>Florent Guelfucci,myoddweb.com</authors>
    <owners>Florent Guelfucci,myoddweb.com</owners>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <readme>README.md</readme>
    <repository type="git" url="https://github.com/FFMG/myoddweb.directorywatcher" branch="main"/>
    <projectUrl>https://github.com/FFMG/myoddweb.directorywatcher</projectUrl>
    <description>A fast and reliable, (non blocking!), .NET File/Directory watcher, complete rewrite of FileSystemWatcher to ensure speed/accuracy/reliability/suppress duplicate events

Supported platforms:
- .NET Framework 4.6.2+
- .NET Standard 2.0+
- .NET 8.0+
    </description>
    <releaseNotes>Version 0.2.0:
- Updated toolset to Visual Studio 2022 (v143)
- Added .NET 8.0 support (dropped deprecated .NET 4.5.2 and .NET Core 3.0)
- Fixed issue #20: full folder copy/paste event detection
- Fixed race conditions during recursive monitor startup and worker pool teardown
- Updated test frameworks to NUnit 4.6.1 and Google Test 1.18.0
    </releaseNotes>
    <tags>DirectoryWatcher FileSystemWatcher IO FileSystem System.IO.FileSystemWatcher dotnet csharp win32 x64 x86</tags>
    <copyright>Copyright (c) 2017-2026 Florent Guelfucci</copyright>
    <language>en-UK</language>
    <dependencies>
      <group targetFramework=".NETFramework4.6.2"/>
      <group targetFramework=".NETStandard2.0"/>
      <group targetFramework="net8.0"/>
    </dependencies>
  </metadata>

  <files>
    <file src="..\..\README.md" target="" />
    <file src="..\..\LICENSE*" target="" />

    <!-- .NET Framework 4.6.2 -->
    <file src="..\bin\release\net462\myoddweb.directorywatcher.dll" target="lib\net462\" />
    <file src="..\bin\release\net462\myoddweb.directorywatcher.pdb" target="lib\net462\" />
    <file src="..\bin\release\net462\myoddweb.directorywatcher.xml" target="lib\net462\" />
    <file src="..\bin\release\net462\myoddweb.directorywatcher.interfaces.dll" target="lib\net462\" />
    <file src="..\bin\release\net462\myoddweb.directorywatcher.interfaces.pdb" target="lib\net462\" />
    <file src="..\bin\release\net462\myoddweb.directorywatcher.interfaces.xml" target="lib\net462\" />

    <!-- .NET Standard 2.0 -->
    <file src="..\bin\release\netstandard2.0\myoddweb.directorywatcher.dll" target="lib\netstandard2.0\" />
    <file src="..\bin\release\netstandard2.0\myoddweb.directorywatcher.pdb" target="lib\netstandard2.0\" />
    <file src="..\bin\release\netstandard2.0\myoddweb.directorywatcher.xml" target="lib\netstandard2.0\" />
    <file src="..\bin\release\netstandard2.0\myoddweb.directorywatcher.interfaces.dll" target="lib\netstandard2.0\" />
    <file src="..\bin\release\netstandard2.0\myoddweb.directorywatcher.interfaces.pdb" target="lib\netstandard2.0\" />
    <file src="..\bin\release\netstandard2.0\myoddweb.directorywatcher.interfaces.xml" target="lib\netstandard2.0\" />

    <!-- .NET 8.0 -->
    <file src="..\bin\release\net8.0\myoddweb.directorywatcher.dll" target="lib\net8.0\" />
