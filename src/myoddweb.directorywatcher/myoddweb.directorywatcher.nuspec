    <file src="..\bin\release\net8.0\myoddweb.directorywatcher.xml" target="lib\net8.0\" />
    <file src="..\bin\release\net8.0\myoddweb.directorywatcher.interfaces.dll" target="lib\net8.0\" />
    <file src="..\bin\release\net8.0\myoddweb.directorywatcher.interfaces.pdb" target="lib\net8.0\" />
    <file src="..\bin\release\net8.0\myoddweb.directorywatcher.interfaces.xml" target="lib\net8.0\" />
  </files>
</package>